{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "michiganhappyhour",
  "compatibility_date": "2026-08-03",
  // Static site lives at the repo root (no build step).
  "pages_build_output_dir": ".",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "michiganhappyhour",
      // Placeholder for local dev. Run `npm run setup:d1` after `npx wrangler login`
      // to create the remote DB and replace this id.
      "database_id": "00000000-0000-4000-8000-000000000001",
      "preview_database_id": "DB",
      "migrations_dir": "migrations"
    }
  ]
}
