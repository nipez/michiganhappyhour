{
  "name": "michiganhappyhour",
  "version": "1.0.0",
  "private": true,
  "description": "Michigan Happy Hour — static site for michiganhappyhour.com",
  "scripts": {
    "dev": "wrangler pages dev .",
    "deploy": "wrangler pages deploy . --project-name=michiganhappyhour",
    "setup:d1": "node scripts/setup-d1.mjs",
    "db:migrate:local": "wrangler d1 migrations apply michiganhappyhour --local",
    "db:migrate:remote": "wrangler d1 migrations apply michiganhappyhour --remote",
    "db:seed-venues": "node scripts/seed-venues.mjs",
    "db:seed-venues:local": "node scripts/seed-venues.mjs --apply-local",
    "db:seed-venues:remote": "node scripts/seed-venues.mjs --apply-remote",
    "db:stats:local": "wrangler d1 execute michiganhappyhour --local --command \"SELECT event_name, COUNT(*) AS c FROM events GROUP BY event_name ORDER BY c DESC\"",
    "db:recent:local": "wrangler d1 execute michiganhappyhour --local --command \"SELECT id, created_at, event_name, spot_name, town, path FROM events ORDER BY id DESC LIMIT 20\"",
    "build:home": "esbuild src/homepage.jsx --bundle --outfile=js/homepage.js --format=iife --jsx=transform --jsx-factory=React.createElement --jsx-fragment=React.Fragment --minify --target=es2018",
    "build": "npm run build:home",
    "test:cache": "node scripts/test-published-venues-cache.mjs",
    "test:towns": "node scripts/test-towns.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "wrangler": "^4.28.0"
  }
}
